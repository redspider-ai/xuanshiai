# ==================== 应用基础配置 ====================
# 应用名称，会显示在 OpenAPI 文档和根路径响应中。
APP_NAME=Xuanshi AI API
# 当前版本号，发布时请同步修改。
APP_VERSION=0.1.0
# 可选值：development、testing、staging、production。
ENVIRONMENT=development
# 开发环境开启调试；生产环境必须改为 false。
DEBUG=true
# 是否暴露 /docs 和 /redoc；生产环境可按安全策略关闭。
DOCS_ENABLED=true
# 监听地址。容器部署通常使用 0.0.0.0，本机开发使用 127.0.0.1。
HOST=127.0.0.1
# FastAPI/Uvicorn 服务端口。
PORT=8000
# API 统一前缀，后续业务接口都挂在该路径下。
API_PREFIX=/api/v1
# 开发/测试环境启动时自动创建数据库和表；staging/production 必须设为 false。
AUTO_INIT_DB=true

# ==================== 数据库与缓存 ====================
# MySQL 异步连接串；请替换用户名、密码、主机、端口和数据库名。
DATABASE_URL=mysql+aiomysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/xuanshiai
# Redis 连接串；用于缓存、限流、验证码和异步任务状态等。
REDIS_URL=redis://127.0.0.1:6379/0

# ==================== 登录与安全 ====================
# JWT 签名密钥；生产环境必须使用高强度随机字符串，禁止提交真实密钥。
SECRET_KEY=change-me-in-local-env
# JWT 签名算法。
JWT_ALGORITHM=HS256
# 访问令牌有效期，单位为分钟。
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh Token 有效期和单账号最多有效设备数。
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_SESSIONS_PER_USER=5
# 验证码策略；短信服务接入后将 SMS_PROVIDER 替换为实际适配器名称。
SMS_CODE_EXPIRE_SECONDS=300
SMS_SEND_INTERVAL_SECONDS=60
SMS_DAILY_LIMIT=10
# 可选值：disabled、mock；真实供应商适配器接入后再填写对应名称。
SMS_PROVIDER=disabled
# 仅 development/testing 环境可使用 mock，固定测试验证码为123456。
SMS_MOCK_CODE=123456
# 微信小程序配置，接入微信登录前必须填写真实值。
WECHAT_PROVIDER=wechat
WECHAT_APP_ID=YOUR_WECHAT_APP_ID
WECHAT_APP_SECRET=YOUR_WECHAT_APP_SECRET
# ==================== 旧测试支付（保留） ====================
# 旧链路仅服务 /payments/test/pay 与 /payments/wechat/callback。
# mock 仅用于 development/testing；staging/production 禁止 mock。
WECHAT_PAYMENT_MODE=mock
# 旧回调 HMAC 验签密钥；real 模式必填（缺失时旧回调返回 503）。
WECHAT_PAYMENT_SIGN_KEY=
# 旧回调 mock 密钥；仅测试环境使用，生产禁止。
WECHAT_PAYMENT_MOCK_SECRET=mock-payment-secret

# ==================== 微信支付 APIv3 网关（新链路） ====================
# 模式：
#   disabled = 不启用新网关（默认）；预支付接口返回 503，旧测试支付不受影响
#   mock     = 仅本地联调；生产/预发禁止
#   real     = 真实微信支付；启动时强校验下列必填项
# 与上面的 WECHAT_PAYMENT_MODE 并存，便于灰度切换和回滚。
WECHAT_PAY_MODE=disabled
# 微信支付 APIv3 基础地址；通常无需修改。
WECHAT_PAY_BASE_URL=https://api.mch.weixin.qq.com
# 商户号（微信支付商户平台 -> 账户中心）。
WECHAT_PAY_MCH_ID=
# 小程序 AppID（必须与商户平台完成 AppID 绑定）。
WECHAT_PAY_APP_ID=
# 商户 API 证书序列号（商户平台 -> API 安全）。
WECHAT_PAY_SERIAL_NO=

# ---- 商户 API 私钥：二选一 ----
# 方式 A：内联 PEM 私钥内容（仅建议本地调试；生产请使用 KMS/密钥管理）。
# 生产环境请使用 KMS 或加密配置，切勿提交真实密钥。
WECHAT_PAY_PRIVATE_KEY=
# 方式 B：只读私钥文件路径（推荐生产使用，文件权限 600）。
# 生产环境请使用 KMS 或加密配置，切勿提交真实密钥。
WECHAT_PAY_PRIVATE_KEY_PATH=

# APIv3 密钥（32 字节），用于 AES-256-GCM 解密回调 resource。
# 生产环境请使用 KMS 或加密配置，切勿提交真实密钥；禁止下发给小程序。
WECHAT_PAY_API_V3_KEY=

# 支付成功回调地址；必须是公网 HTTPS，且与微信商户平台配置一致。
WECHAT_PAY_NOTIFY_URL=https://YOUR_DOMAIN/api/v1/payments/wechat/notify
# 退款结果回调地址；必须是公网 HTTPS。
WECHAT_PAY_REFUND_NOTIFY_URL=https://YOUR_DOMAIN/api/v1/payments/wechat/refund-notify

# ---- 公钥模式（与平台证书模式二选一）----
# 配置 PUBLIC_KEY_ID 后不再下载平台证书；未配置则使用平台证书模式。
WECHAT_PAY_PUBLIC_KEY_ID=
# 微信支付公钥 PEM（内联）；生产环境建议通过 KMS/只读文件注入。
WECHAT_PAY_PUBLIC_KEY=
# 微信支付公钥只读文件路径（与内联值二选一，推荐生产使用）。
# 生产环境请使用 KMS 或加密配置，切勿提交真实密钥。
WECHAT_PAY_PUBLIC_KEY_PATH=

# 单次微信 API 请求超时（秒）。
WECHAT_PAY_TIMEOUT_SECONDS=10
# 回调时间戳允许的时钟偏移（秒），默认 300。
WECHAT_PAY_MAX_CLOCK_SKEW_SECONDS=300

# Mock 微信凭证格式为 mock-code-001，仅允许 development/testing 环境。
WECHAT_MOCK_OPENID_PREFIX=mock-openid-
# 当前发布的协议版本，格式为 agreement_type:version，多个用逗号分隔。
AGREEMENT_VERSIONS_RAW=user_service:v1,privacy_policy:v1,safety_pledge:v1,community_rules:v1

# ==================== 跨域、文件与日志 ====================
# 多个来源使用英文逗号分隔，不要在生产环境使用 *。
CORS_ORIGINS_RAW=http://localhost:3000,http://localhost:5173
# 用户上传文件的本地存储目录；生产环境可替换为对象存储挂载目录。
UPLOAD_DIR=storage/uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000
WECHAT_MINI_PROGRAM_PAGE=pages/profile/profile

# Discovery quotas. Keep these values server-side; do not accept them from clients.
RECOMMENDATION_PAGE_SIZE=20
BROWSE_DAILY_LIMIT=8
BROWSE_HIGH_MATCH_BONUS=5
APPLY_DAILY_FREE_LIMIT=3
APPLY_DAILY_VIP_LIMIT=10
SUPERLIKE_DAILY_FREE_LIMIT=1
SUPERLIKE_DAILY_VIP_LIMIT=3
PAPER_PLANE_DAILY_LIMIT=3

# ==================== AI 分身 ====================
# 生产环境启用链（缺任何一步启动即 fail-closed，Settings 校验失败）：
# 1) AI_MASTER_ENABLED=true（分身与其他 AI 功能共用总闸）；
# 2) 三道审批齐：AI_POLICY_APPROVED=true、AI_PROVIDER_APPROVED=true、
#    AI_RETENTION_POLICY_VERSION 非空；
# 3) SECRET_KEY 至少 32 位非占位、DEBUG=false、DOCS_ENABLED=false；
# 4) AI_AVATAR_PROVIDER=openai_compatible，且 AI_AVATAR_BASE_URL 必须 HTTPS。
# 分身走独立的 AI_AVATAR_BASE_URL/模型通道：仅启用分身（不打开其他 AI 开关、
# AI_ENABLED 保持 false）时，AI_PROVIDER 可保持 mock，不触发军师 provider
# 专项检查。但如需无状态公开答复（POST /ai/avatar/{id}/reply，经 legacy
# 军师栈），还必须 AI_ENABLED=true 并配置真实军师 provider——此时 provider
# 专项检查生效：AI_PROVIDER 不得为 mock，deepseek/dots 需分别配置 API key。
# disabled：关闭真实 AI；openai_compatible：调用兼容 /chat/completions 的服务。
AI_AVATAR_PROVIDER=disabled
# 服务根地址需包含供应商要求的 API 前缀，后端会追加 /chat/completions；
# staging/production 必须 HTTPS。
AI_AVATAR_BASE_URL=https://api.example.com/v1
# 真实密钥只填写在本机 .env 或服务器密钥管理中，禁止提交。
AI_AVATAR_API_KEY=YOUR_AI_API_KEY
AI_AVATAR_MODEL=YOUR_AI_MODEL
AI_AVATAR_TIMEOUT_SECONDS=20
AI_AVATAR_MAX_OUTPUT_TOKENS=500
AI_AVATAR_MAX_CONTEXT_MESSAGES=12
AI_AVATAR_DAILY_LIMIT=20
# 阿里云云市场敏感词二次审核。默认关闭，配置真实接口信息后再启用。
ALIYUN_CONTENT_MODERATION_ENABLED=false
ALIYUN_CONTENT_MODERATION_BASE_URL=https://lxmingan.market.alicloudapi.com
ALIYUN_CONTENT_MODERATION_PATH=/YOUR_API_PATH
ALIYUN_CONTENT_MODERATION_APP_CODE=YOUR_ALIYUN_MARKET_APPCODE
# 云市场接口文档要求 JSON 时使用 json，要求表单时使用 form。
ALIYUN_CONTENT_MODERATION_REQUEST_MODE=json
ALIYUN_CONTENT_MODERATION_TEXT_FIELD=text
ALIYUN_CONTENT_MODERATION_TIMEOUT_SECONDS=2.5
# 阿里云不可用时：review 进入人工审核，reject 直接拒绝。
ALIYUN_CONTENT_MODERATION_FAIL_MODE=review
# 阿里云命中但未返回明确业务动作时的默认动作。
ALIYUN_CONTENT_MODERATION_DEFAULT_ACTION=manual_review
# 牵线服务首次创建次数账户时的默认次数；正式规则应改为配置中心或后台规则。
COMMUNITY_CITY_COOLDOWN_DAYS=7
MATCHMAKER_SERVICE_DEFAULT_QUOTA=0

# ==================== 会员价格与积分配置 ====================
# 会员价格覆盖数据库套餐配置，单位为元；未设置时使用数据库值。
# MEMBERSHIP_MONTHLY_PRICE=99
# MEMBERSHIP_QUARTERLY_PRICE=269
# MEMBERSHIP_YEARLY_PRICE=899
# MEMBERSHIP_MONTHLY_ORIGINAL_PRICE=129
# MEMBERSHIP_QUARTERLY_ORIGINAL_PRICE=329
# MEMBERSHIP_YEARLY_ORIGINAL_PRICE=1099
# MEMBERSHIP_MONTHLY_DAILY_PRICE=3.30
# MEMBERSHIP_QUARTERLY_DAILY_PRICE=2.99
# MEMBERSHIP_YEARLY_DAILY_PRICE=2.46

# 积分奖励配置，单位为分。
POINT_CHECKIN_REWARD=5
POINT_PROFILE_COMPLETE_REWARD=50
POINT_REALNAME_VERIFIED_REWARD=100

# 积分商品每次消耗配置，设置后覆盖 config_point_product.points_cost。
# 商品名称、库存、上下架和权益内容仍由数据库配置。
# POINT_COST_EXTRA_APPLY=20
# POINT_COST_EXTRA_SUPERLIKE=50
# POINT_COST_BROWSE_UNLOCK=10
# POINT_COST_EXPOSURE_CARD=100
# POINT_COST_PAPER_PLANE_UNLOCK=30
# POINT_COST_PROFILE_DETAIL_UNLOCK=10
# POINT_COST_MEMBERSHIP_EXCHANGE=1000
# POINT_COST_SERVICE_COUPON=500

# ==================== Testing and integration (testing only) ====================
# Database-backed tests require ENVIRONMENT=testing. Never use a test database in production.
# COMMUNITY_TEST_DATABASE_URL=mysql+aiomysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/xuanshiai_test
# Base URL for live HTTP integration tests; unset tests are skipped.
# LIVE_API_BASE=http://127.0.0.1:8000/api/v1
# 日志级别，可选 DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO

# ==================== AI 画像 / 搜索 / 匹配度 ====================
# 一期全部默认关闭。生产环境启用任何 AI 开关前，必须同时满足
# AI_POLICY_APPROVED=true、AI_PROVIDER_APPROVED=true、AI_RETENTION_POLICY_VERSION
# 非空，且 AI_PROVIDER 不是 mock；否则 Settings 校验失败并对外保持
# HTTP 503 AI_FEATURE_DISABLED（retryable=false）。
AI_MASTER_ENABLED=false
AI_PROFILE_ENABLED=false
AI_SEARCH_ENABLED=false
AI_COMPATIBILITY_SHADOW_ENABLED=false
# 一期默认 mock；真 provider 可选 deepseek / dots。生产环境启用 AI 时
# 禁止使用 mock。
AI_PROVIDER=mock
# 生产启用门禁（未批准时保持 false/空）。
AI_POLICY_APPROVED=false
AI_PROVIDER_APPROVED=false
AI_RETENTION_POLICY_VERSION=
# DeepSeek provider（OpenAI 兼容 API）。真实 api_key 仅存于被忽略的 .env，
# 此处只放占位符。deepseek-chat 已弃用，由 deepseek-v4-flash 接替。
AI_DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_MODEL=deepseek-v4-flash
AI_DEEPSEEK_MAX_TOKENS=2048
# Dots provider（小红书 hi lab dots.llm，OpenAI 兼容 API）。真实 api_key 仅存于
# 被忽略的 .env，此处只放占位符。dots3-note-prev 为推理模型，max_tokens 需覆盖
# 推理消耗，默认 4096。
AI_DOTS_API_KEY=YOUR_DOTS_API_KEY
AI_DOTS_BASE_URL=https://note3-prev-api.askdiandian.com/v1
AI_DOTS_MODEL=dots3-note-prev
AI_DOTS_MAX_TOKENS=4096
# Narrative 专用模型覆盖（可选）。画像叙事层 generate_narrative 是重推理任务，
# 默认走主 provider 的模型。若主 provider 是推理模型（如 dots3-note-prev），生成
# 耗时可达数十秒；通过此项指定一个更快的非推理模型 + 配套 provider 单独驱动
# narrative，其余方法（抽取/搜索/回复）不受影响。留空则回退到主 provider。
AI_NARRATIVE_PROVIDER=
AI_NARRATIVE_MODEL=
AI_NARRATIVE_MAX_TOKENS=0
# AI 任务/租约/重试/限流配置。
AI_LEASE_SECONDS=300
AI_MAX_ATTEMPTS=3
AI_SEARCH_PARSE_RATE_PER_MINUTE=5
AI_PROFILE_SESSION_EXPIRE_DAYS=7
AI_SEARCH_DRAFT_EXPIRE_HOURS=24
AI_COMPATIBILITY_SNAPSHOT_TTL_MINUTES=10
# AIGateway 统一超时，覆盖画像叙事/搜索/兼容性/资料卡等全部场景。
# 推理类 provider（如 dots3-note-prev）单次可达 30s+，30 会掐断资料卡
# 生成；默认给 60，上限 120。
AI_GATEWAY_TIMEOUT_SECONDS=60.0

# ==================== 语音（STT/TTS）P-04 / Phase 4 ====================
# 默认关闭。生产启用需满足三道审批门禁 + AccessKey 配置；
# 还须完成阿里云 DPA / 数据出境审查。
AI_VOICE_ENABLED=false
AI_VOICE_PROVIDER=aliyun
#   AI_ALIYUN_VOICE_API_KEY=<your_key>
#   AI_ALIYUN_VOICE_APP_KEY=<your_app_key>
AI_ALIYUN_VOICE_REGION=cn-shanghai
AI_ALIYUN_VOICE_ASR_MODEL=paraformer-realtime-v2
AI_ALIYUN_VOICE_TTS_MODEL=cosyvoice-v1
AI_TTS_MAX_TEXT_LENGTH=500
AI_ASR_MAX_DURATION_SECONDS=60
AI_VOICE_AUDIO_RETENTION_HOURS=24
# worker 主循环执行语音临时音频清理的最小间隔（秒），0 表示每轮都尝试。
AI_VOICE_AUDIO_CLEANUP_INTERVAL_SECONDS=3600
# Memory State TTL 过期清理（worker 主循环定时任务）：单批行数 / 单轮批次
# 数上限 / 单轮墙钟时间预算（秒）/ 最小执行间隔（秒，0 表示每轮都尝试）。
AI_MEMORY_STATE_TTL_BATCH_SIZE=200
AI_MEMORY_STATE_TTL_MAX_BATCHES=10
AI_MEMORY_STATE_TTL_TIME_BUDGET_SECONDS=30
AI_MEMORY_STATE_TTL_CLEANUP_INTERVAL_SECONDS=3600
# ==================== 实时半双工语音对话（P-04b）====================
# 后端调阿里云 NLS 实时 ASR 边说边出字，再 DeepSeek 画像抽取 + TTS 回复。
# 默认关闭；生产启用需满足三道门禁 + AccessKey 配置。
# 实时 ASR 鉴权需要 AccessKey ID/Secret（换取 NLS Token），与 REST 模式的
# api_key/app_key 不同：凭据仅存于被忽略的 .env，不进 .env.example。
#   AI_ALIYUN_VOICE_ACCESS_KEY_ID=<your_access_key_id>
#   AI_ALIYUN_VOICE_ACCESS_KEY_SECRET=<your_access_key_secret>
AI_VOICE_CONVERSATION_ENABLED=false
AI_VOICE_CONVERSATION_MAX_TURN_SECONDS=60
AI_ALIYUN_VOICE_ASR_WS_URL=wss://nls-gateway.cn-shanghai.aliyuncs.com/ws/v1

# ==================== AI 军师（产品口径冻结后调整） ====================
AI_ENABLED=false
# dev/testing 在 AI_ENABLED=false 时回退本地 mock 的总开关（默认 true，保持
# 既有开发行为；回退发生时会输出 ai_mock_fallback warning 日志）。置 false
# 后 dev/testing 的 mock 回退改为 503「AI服务未启用」。生产环境本就禁止
# mock，不受此开关影响。
AI_ALLOW_MOCK_FALLBACK=true
AI_PROVIDER=mock
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# AI_API_KEY=YOUR_AI_API_KEY
AI_DAILY_ADVISOR_LIMIT=20
AI_ADVISOR_MAX_CONTEXT_MESSAGES=80
AI_ADVISOR_PROMPT_VERSION=relationship-v1
AI_ADVISOR_KNOWLEDGE_VERSION=seed-v2
# 直播相亲（未配置腾讯云密钥时凭证接口会安全拒绝）
LIVE_ENABLED=false
LIVE_PROVIDER=mock
# TRTC 控制台的 SDKAppID 与 SDKSecretKey，仅用于客户端 UserSig。
# TENCENT_LIVE_SDK_APP_ID=
# TENCENT_LIVE_SDK_SECRET_KEY=
# CAM 最小权限子账号凭据，仅用于服务端腾讯云控制面 API。
# TENCENT_LIVE_SECRET_ID=
# TENCENT_LIVE_SECRET_KEY=
TENCENT_LIVE_REGION=ap-guangzhou
TENCENT_LIVE_API_TIMEOUT_SECONDS=5
TENCENT_LIVE_MAX_RETRIES=2
TENCENT_LIVE_USER_SIG_TTL_SECONDS=900
LIVE_RTC_TICKET_LIMIT_PER_MINUTE=10
# TENCENT_LIVE_CALLBACK_SECRET=
TENCENT_LIVE_CALLBACK_MAX_SKEW_SECONDS=300
TENCENT_LIVE_CALLBACK_MAX_BODY_BYTES=65536
# 按已开通腾讯产品的官方回调事件值填写，逗号分隔；未确认前保持为空并安全拒绝回调。
TENCENT_LIVE_CALLBACK_EVENT_TYPES_RAW=
TENCENT_LIVE_CLOUD_RECORDING_ENABLED=false
TENCENT_LIVE_MIX_STREAM_ENABLED=false
TENCENT_LIVE_CSS_ENABLED=false

# ==================== 后台运营第三方服务商（A1/A2/A3/A6 适配层） ====================
# 短信模板群发：厂商未定前保持 disabled（管理端接口 503 明确报错）。
SMS_TEMPLATE_PROVIDER=disabled
# SMS_ACCESS_KEY=YOUR_SMS_ACCESS_KEY
# SMS_ACCESS_SECRET=YOUR_SMS_ACCESS_SECRET
# 微信公众号平台凭据（库内 wechat_mp 配置只存非敏感项，密钥走这里）。
# WECHAT_MP_APP_ID=YOUR_WECHAT_MP_APP_ID
# WECHAT_MP_APP_SECRET=YOUR_WECHAT_MP_APP_SECRET
# WECHAT_MP_TOKEN=YOUR_WECHAT_MP_TOKEN
# WECHAT_MP_AES_KEY=YOUR_WECHAT_MP_AES_KEY
# 腾讯电子签：无凭证时合同创建/签署/作废接口 503。
# TENCENT_ESIGN_SECRET_ID=YOUR_TENCENT_ESIGN_SECRET_ID
# TENCENT_ESIGN_SECRET_KEY=YOUR_TENCENT_ESIGN_SECRET_KEY
# TENCENT_ESIGN_OPERATOR_OPEN_ID=YOUR_TENCENT_ESIGN_OPERATOR_OPEN_ID
# 电话外呼平台（捷讯）：API 未定前保持 disabled。
OUTBOUND_CALL_PROVIDER=disabled
# OUTBOUND_CALL_BASE_URL=
# OUTBOUND_CALL_ACCOUNT=YOUR_OUTBOUND_CALL_ACCOUNT
# OUTBOUND_CALL_SECRET=YOUR_OUTBOUND_CALL_SECRET
# OUTBOUND_CALL_TIMEOUT_SECONDS=10

# ==================== 属地解析（A12：一键刷新 IP / 手机属地） ====================
# 门控：disabled（默认）→ 刷新接口 503；mock → 干跑（只统计候选行、不写库）；
#       offline → 离线解析并写库；real → 在线厂商适配器（未实现，返回 501）。
# 预发/生产禁止 mock（否则 Settings 校验失败，服务启动即报错）。
REGION_RESOLVER_PROVIDER=disabled
# IP 库（ip2region_v4.xdb，约 11MB；商用满载版约 266MB）。不随仓库分发，由部署下发并记录 sha256。
# 缺省读取仓库内 data/region/ip2region_v4.xdb；缺失时接口 503，不写任何数据。
# REGION_IP_DB_PATH=/home/xuanshiai/data/region/ip2region_v4.xdb
# IPv6 库（ip2region_v6.xdb，约 34MB，预留）。当前 IPv6 源值计入 skipped，不下发则无需配置。
# REGION_IP_V6_DB_PATH=/home/xuanshiai/data/region/ip2region_v6.xdb
# 城市字段下标（按「过滤掉空段与 0 段后」的位置计）：开源 3.x=2，商用满载版=3。
# 换数据文件必须核对，否则会静默取错字段（属地把整批偏移一级）。
REGION_IP_CITY_INDEX=2
# 手机号段表（CSV：prefix,province,city,isp,updated_at；建议月度更新）。
# 缺省读取仓库内 data/region/phone_segment.csv；缺失时 refresh-phone-region 返回 503。
# REGION_PHONE_SEGMENT_PATH=/home/xuanshiai/data/region/phone_segment.csv
# 每批回写行数（executemany）。量级上万时再考虑多值 UPDATE / 临时表 JOIN。
REGION_REFRESH_BATCH_SIZE=500
# overwrite=true 的单次上限；超出返回 409，要求改用脚本分批执行。
REGION_REFRESH_OVERWRITE_MAX_ROWS=5000
